# ── Face to Face — configuration PRODUCTION ──
# Copier en .env.production (jamais committé) ou renseigner ces variables chez l'hébergeur.
# Vérifier avant tout déploiement :  npm run check:prod
NODE_ENV=production
PORT=4000

# Base PostgreSQL gérée (SSL activé). Jamais localhost.
DATABASE_URL=postgresql://postgres:gregmartian@HOTE:5432/facetoface?sslmode=require
# 48 octets aléatoires :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=VOTRE_CLE_SECRETE_JWTAQZSEDRFTGYHUJIKOLPM¨%£%µQWSXDCFVGBHNJ?K.L/M§%

# URL publique HTTPS de l'API (liens de partage, avatars)
PUBLIC_BASE_URL=https://api.VOTRE-DOMAINE.com
# Origines web/admin autorisées (l'app mobile n'est pas concernée par CORS). Obligatoire en production.
CORS_ORIGINS=https://admin.VOTRE-DOMAINE.com
# true si l'API est derrière un reverse-proxy / load balancer (Render, Railway, Fly, Nginx…)
TRUST_PROXY=true
RATE_LIMIT_ENABLED=true
BCRYPT_COST=12

# ── Stockage objet + CDN ──
STORAGE_DRIVER=s3
# Vide = AWS S3 ; sinon l'URL de Cloudflare R2 / autre
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
CDN_URL=https://cdn.VOTRE-DOMAINE.com

# ── Paiements Mobile Money (MyPVit) ──
PAYMENT_DRIVER=mypvit
PAYMENT_WEBHOOK_SECRET=
MYPVIT_API_PASSWORD=
MYPVIT_URLCODE_RENEW_SECRET=
MYPVIT_URLCODE_REST=
MYPVIT_URLCODE_STATUS=
MYPVIT_CALLBACK_URL_CODE=
MYPVIT_RECEPTION_URL_CODE=
MYPVIT_ACCOUNT_AIRTEL=
MYPVIT_ACCOUNT_MOOV=
# IP de MyPVit autorisées pour les webhooks (obligatoire en production)
MYPVIT_WEBHOOK_ALLOWED_IPS=

# ── Appels audio/vidéo (LiveKit) ──
CALL_PROVIDER=livekit
LIVEKIT_URL=wss://livekit.VOTRE-DOMAINE.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── E-mails (obligatoire en production) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Face to Face <no-reply@VOTRE-DOMAINE.com>

# ── Administration (identifiants de comptes séparés par des virgules) ──
ADMIN_USER_IDS=
VIEW_MONETIZATION_ADMIN_USER_IDS=
PREMIUM_ADMIN_USER_IDS=
