enum CreatorSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  CANCELLED
  EXPIRED
}

enum CreatorSubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
  REVIEW
}

/// Offre d'abonnement mensuel d'un créateur. Les avantages sont stockés comme configuration de produit, sans imposer de moyen de paiement.
model CreatorSubscriptionPlan {
  id                    String   @id @default(cuid())
  creatorId             String   @unique
  priceMinor            Int
  currency              String   @db.VarChar(3)
  benefits              Json
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  creator       User                   @relation("CreatorSubscriptionPlanOwner", fields: [creatorId], references: [id], onDelete: Cascade)
  subscriptions CreatorSubscription[]

  @@index([isActive, creatorId])
}

/// Droit d'accès d'un utilisateur aux avantages d'un créateur. Un abonnement actif couvre un mois à partir du paiement confirmé.
model CreatorSubscription {
  id          String                    @id @default(cuid())
  subscriberId String
  creatorId   String
  planId      String
  status      CreatorSubscriptionStatus @default(PENDING_PAYMENT)
  currency    String                    @db.VarChar(3)
  priceMinor  Int
  startedAt   DateTime?
  expiresAt   DateTime?
  cancelledAt DateTime?
  autoRenew   Boolean                   @default(false)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  subscriber User                    @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id], onDelete: Restrict)
  creator    User                    @relation("CreatorSubscribers", fields: [creatorId], references: [id], onDelete: Restrict)
  plan       CreatorSubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments   CreatorSubscriptionPayment[]

  @@unique([subscriberId, creatorId])
  @@index([creatorId, status, expiresAt])
  @@index([subscriberId, status, expiresAt])
}

/// Tentative de paiement d'un abonnement, conservée séparément pour l'audit et l'idempotence.
model CreatorSubscriptionPayment {
  id              String                           @id @default(cuid())
  subscriptionId  String
  buyerId         String
  creatorId       String
  grossFcfa       Int
  commissionFcfa  Int
  creatorFcfa     Int
  commissionBps   Int
  status          CreatorSubscriptionPaymentStatus @default(PENDING)
  reference       String?                          @unique
  attempts        Int                              @default(1)
  initiatedAt     DateTime                         @default(now())
  operator        String?
  payerPhoneHint  String?
  externalRef     String?
  reviewReason    String?
  providerPayload Json?
  createdAt       DateTime                         @default(now())
  paidAt          DateTime?

  subscription CreatorSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  buyer        User                @relation("SubscriptionBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  creator      User                @relation("SubscriptionCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  @@index([creatorId, status])
  @@index([buyerId, status])
  @@index([status, initiatedAt])
}



// ── Étape 12 : vidéos personnalisées ───────────────────────────────
enum CustomVideoStatus {
