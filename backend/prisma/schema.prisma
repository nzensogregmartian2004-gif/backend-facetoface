  @@index([targetType, targetId, createdAt])
  @@index([authorId])
}

// Une ligne par vue comptée (dédoublonnée par utilisateur et par fenêtre de temps). Les vues qualifiées et l'anti-fraude arrivent aux étapes 8, 9 et 20.
model ContentView {
