}

/// Destinataire d'une photo ou vidéo à vue unique, figé à l'envoi (membres présents à ce moment).
/// `openedAt` : première et unique ouverture par ce destinataire. Une ligne ouverte ne se réinitialise jamais.
model ViewOnceRecipient {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  openedAt  DateTime?
  createdAt DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, openedAt])
}

/// « Supprimer pour moi » : le message disparaît seulement de la vue de ce membre.
model HiddenMessage {
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

/// Message favori (étoile) d'un membre. Ne concerne que les messages auxquels il a accès.
model StarredMessage {
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, createdAt])
}

/// Accès payant à un groupe : une ligne par (groupe, acheteur). Montants et commission figés à la création, comme les messages payants.
model GroupAccessPurchase {
  id               String         @id @default(cuid())
  conversationId   String
  buyerId          String
  sellerId         String
  grossAmount      Int
  commissionAmount Int
  creatorAmount    Int
  currency         String         @default("XAF") @db.VarChar(3)
  commissionBps    Int
  status           PurchaseStatus @default(PENDING)
  reference        String?        @unique
  attempts         Int            @default(1)
  initiatedAt      DateTime       @default(now())
  method           String?
  operator         String?
  payerPhoneHint   String?
  externalRef      String?
  reviewReason     String?
  providerPayload  Json?
  /// Invitation utilisée à l'achat : vérifiée de nouveau au règlement (révoquée, épuisée, groupe complet).
  inviteId         String?
  createdAt        DateTime       @default(now())
  paidAt           DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  buyer        User         @relation("GroupAccessBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller       User         @relation("GroupAccessSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([conversationId, buyerId])
  @@index([sellerId, status])
  @@index([status, initiatedAt])
}

/// Story : photo ou vidéo publiée sur le profil de son auteur, visible pendant `hours` heures puis supprimée (fichier compris).
model Story {
  id        String   @id @default(cuid())
  authorId  String
  /// Clé du fichier dans le stockage privé. Unique : un fichier ne sert qu'à une story.
  mediaKey  String   @unique
  /// IMAGE ou VIDEO.
  mediaType String
  mediaMime String
  mediaSize Int
  caption   String?  @db.VarChar(200)
  /// Durée de vie choisie par l'auteur, en heures.
  hours     Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  author User        @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  views  StoryView[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

/// Vue d'une story par un spectateur : une seule ligne par couple.
model StoryView {
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation("StoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
  @@index([viewerId])
}
